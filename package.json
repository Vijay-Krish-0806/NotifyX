{
  "name": "notifyx",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant, event-driven notification platform",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml --project-directory . up -d --wait",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml --project-directory . down",
    "infra:ps": "docker compose -f infra/docker/docker-compose.yml --project-directory . ps",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml --project-directory . logs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
