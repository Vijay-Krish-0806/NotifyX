# NotifyX local configuration. Copy to .env (never commit .env).
# Every variable is documented in docs/ARCHITECTURE.md § Configuration.
# All values below are local-only development defaults.

# --- Docker Compose (infra/docker/docker-compose.yml) ---
# Optional: Compose uses these same defaults when unset.
POSTGRES_USER=notifyx
POSTGRES_PASSWORD=notifyx
POSTGRES_DB=notifyx

# Host ports (bound to 127.0.0.1). Change one if it clashes with something on your machine.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8080
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# --- App connection URLs (apps run on the host; read by the API and worker from M1 step 4/6) ---
# Use 127.0.0.1, not localhost: localhost can resolve to IPv6 ::1 first, but Docker publishes on IPv4 only.
DATABASE_URL=postgresql://notifyx:notifyx@127.0.0.1:5433/notifyx
REDIS_URL=redis://127.0.0.1:6379
KAFKA_BROKERS=127.0.0.1:9092
