{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(git check-attr *)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git push -u origin main)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(file *)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git commit --amend *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git rebase *)"
    ],
    "deny": [
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(git reflog expire *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)"
    ]
  }
}
