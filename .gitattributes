# Normalize line endings: store LF in the repo and check out LF on every OS.
# Overrides a machine's core.autocrlf, so shell scripts and Dockerfiles stay LF on Windows.
* text=auto eol=lf

# Windows-only scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch line endings, never diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.woff binary
*.woff2 binary
